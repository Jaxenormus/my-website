---
import "../styles/global.css";

import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";

import Experience from "@/components/Experience.astro";
import Photos from "@/components/Photos.astro";
import Section from "@/components/Section.astro";
import { SEO } from "astro-seo";

import syncoreImage from "@/assets/images/syncore.png";
import whopImage from "@/assets/images/whop.png";
import phiaImage from "@/assets/images/phia.png";
import bouncrImage from "@/assets/images/bouncr.png"
import selfEmployedImage from "@/assets/images/self-employed.png";

const photos = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../../public/images/carousel/*.{jpeg,jpg,png}", { eager: true })
).map((module) => module.default);

const meta = {
  title: "caleb delbridge",
  description: "product engineer based in brooklyn, ny",
  url: "https://calebdelbridge.com",
  image: "/og.png",
};
---

<html lang="en" class="bg-[#161618] text-white font-mono overscroll-x-none overscroll-y-none">
  <head>
    <meta charset="utf-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-mono" preload />
    <SEO
      title={meta.title}
      description={meta.description}
      canonical={meta.url}
      openGraph={{
        basic: {
          title: meta.title,
          type: "website",
          url: meta.url,
          image: meta.image,
        },
        optional: { description: meta.description },
      }}
      twitter={{
        title: meta.title,
        description: meta.description,
        image: meta.image,
        card: "summary_large_image",
        creator: "@jaxenormus",
        site: meta.url,
      }}
    />
  </head>
  <body class="overflow-x-clip">
    <main class="max-w-2xl mx-5 md:mx-auto my-16 md:my-32 space-y-8 md:space-y-16">
      <Section id="hero" title="hey there 👋">
        <p class="text-zinc-400 -mt-2">
          i'm caleb, a product engineer based in brooklyn, ny. i'm the co-founder and cto of <span class="text-[#EE533D]">bouncr labs</span>, where we develop tooling and software to power real time identity verification for physical businesses.
        </p>
        <div class="mt-6 flex gap-6">
          <a class="group -m-1 p-1" href="https://x.com/jaxenormus">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300">
              <path d="M13.3174 10.7749L19.1457 4H17.7646L12.7039 9.88256L8.66193 4H4L10.1122 12.8955L4 20H5.38119L10.7254 13.7878L14.994 20H19.656L13.3171 10.7749H13.3174ZM11.4257 12.9738L10.8064 12.0881L5.87886 5.03974H8.00029L11.9769 10.728L12.5962 11.6137L17.7652 19.0075H15.6438L11.4257 12.9742V12.9738Z"/>
            </svg>
          </a>
          <a class="group -m-1 p-1" href="https://github.com/jaxenormus">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.475 2 2 6.588 2 12.253c0 4.537 2.862 8.369 6.838 9.727.5.09.687-.218.687-.487 0-.243-.013-1.05-.013-1.91C7 20.059 6.35 18.957 6.15 18.38c-.113-.295-.6-1.205-1.025-1.448-.35-.192-.85-.667-.013-.68.788-.012 1.35.744 1.538 1.051.9 1.551 2.338 1.116 2.912.846.088-.666.35-1.115.638-1.371-2.225-.256-4.55-1.14-4.55-5.062 0-1.115.387-2.038 1.025-2.756-.1-.256-.45-1.307.1-2.717 0 0 .837-.269 2.75 1.051.8-.23 1.65-.346 2.5-.346.85 0 1.7.115 2.5.346 1.912-1.333 2.75-1.05 2.75-1.05.55 1.409.2 2.46.1 2.716.637.718 1.025 1.628 1.025 2.756 0 3.934-2.337 4.806-4.562 5.062.362.32.675.936.675 1.897 0 1.371-.013 2.473-.013 2.82 0 .268.188.589.688.486a10.039 10.039 0 0 0 4.932-3.74A10.447 10.447 0 0 0 22 12.253C22 6.588 17.525 2 12 2Z"/>
            </svg>
          </a>
          <a class="group -m-1 p-1" href="https://www.linkedin.com/in/calebdelbridge/">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300"><path d="M18.335 18.339H15.67v-4.177c0-.996-.02-2.278-1.39-2.278-1.389 0-1.601 1.084-1.601 2.205v4.25h-2.666V9.75h2.56v1.17h.035c.358-.674 1.228-1.387 2.528-1.387 2.7 0 3.2 1.778 3.2 4.091v4.715zM7.003 8.575a1.546 1.546 0 01-1.548-1.549 1.548 1.548 0 111.547 1.549zm1.336 9.764H5.666V9.75H8.34v8.589zM19.67 3H4.329C3.593 3 3 3.58 3 4.297v15.406C3 20.42 3.594 21 4.328 21h15.338C20.4 21 21 20.42 21 19.703V4.297C21 3.58 20.4 3 19.666 3h.003z"/>
            </svg>
          </a>
        </div>
      </Section>
      <Photos images={photos} />
      <Section id="experience" title="experience">
        <div class="flex flex-col gap-5">
          <Experience
            company="bouncr labs"
            image={bouncrImage}
            position="co-founder"
            start="2026"
            end="present"
          />
          <span
            class="w-px h-5 ml-[19px] border border-dashed border-zinc-400/50 -my-2.5 hidden min-[400px]:block"
          ></span>
          <Experience
            company="phia"
            image={phiaImage}
            position="founding engineer"
            start="2025"
            end="2026"
          />
          <span
            class="w-px h-5 ml-[19px] border border-dashed border-zinc-400/50 -my-2.5 hidden min-[400px]:block"
          ></span>
          <Experience
            company="whop"
            image={whopImage}
            position="software engineer"
            start="2023"
            end="2025"
          />
          <span
            class="w-px h-5 ml-[19px] border border-dashed border-zinc-400/50 -my-2.5 hidden min-[400px]:block"
          ></span>
          <Experience
            company="syncore"
            image={syncoreImage}
            position="frontend developer"
            start="2021"
            end="2022"
          />
          <span
            class="w-px h-5 ml-[19px] border border-dashed border-zinc-400/50 -my-2.5 hidden min-[400px]:block"
          ></span>
          <Experience
            company="self employed"
            image={selfEmployedImage}
            position="freelance developer"
            start="2020"
            end="2023"
          />
        </div>
      </Section>
    </main>
  </body>
</html>
